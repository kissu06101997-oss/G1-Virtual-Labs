# G1 Virtual Labs — Local Environment Configuration Example
# Copy this file to .env.local and replace values for local development.
# NEVER commit .env.local or real credentials.

# PostgreSQL 16+ connection string.
# By default, `npm run db:start` runs an embedded local PostgreSQL-compatible
# PGlite socket server on 127.0.0.1:54329 backed by .data/pgdata.
# To use a standalone PostgreSQL 16+ instance, point DATABASE_URL to it instead.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/g1_virtua_labs
G1_PG_HOST=127.0.0.1
G1_PG_PORT=54329
G1_PG_DATA_DIR=.data/pgdata

# Cryptographic secret for HMAC-signed HTTP-only session cookies (min 32 chars).
# Replace with a randomly generated value in .env.local.
SESSION_SECRET=replace-with-local-dev-random-secret-at-least-32-chars

# Application origin used for same-origin launch token audience verification.
APP_ORIGIN=http://127.0.0.1:3000

# Optional AI tutor MUST remain disabled until legal, privacy and cost approval.
ENABLE_OPTIONAL_TUTOR=false

# Local synthetic fixtures flag (must be false in any real school deployment).
ALLOW_LOCAL_SYNTHETIC_FIXTURES=true

# Optional contact-inquiry alerts. Leave empty to record inquiries without email.
# Use a verified Resend sender and server-only restricted API key.
# Synthetic fixture mode always disables sending.
CONTACT_RESEND_API_KEY=
CONTACT_EMAIL_FROM=
