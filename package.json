{
  "name": "g1-virtua-labs",
  "version": "0.1.0",
  "private": true,
  "description": "G1 Virtual Labs — Bilingual Andhra Pradesh Virtual Science Laboratory Platform (Website Foundation)",
  "scripts": {
    "db:start": "node scripts/db-server.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:seed:catalog": "node scripts/db-seed-catalog.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "media:local": "node --env-file=.env.local scripts/media-store.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:local": "node scripts/run-local.mjs dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:local": "node scripts/run-local.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@vercel/blob": "2.4.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.187.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@ffprobe-installer/linux-x64": "5.2.0"
  }
}
